#--------------------------------------------------------------------
# WBSC Application - Environment Configuration
#--------------------------------------------------------------------
# Location: D:/local-wwwroot/wbsc-app/.env
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าตามความเหมาะสม
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8083/wbsc-app/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# สำคัญ: ตั้งเป็นค่าว่างเพื่อใช้ URL Rewriting
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE - MariaDB/MySQL (Moodle)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = wbsc_lms_2020
database.default.username = root
database.default.password = your_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# DATABASE - Oracle (Registry System)
#--------------------------------------------------------------------

database.oracle.hostname = oracle-server
database.oracle.database = ORCL
database.oracle.username = WBSC
database.oracle.password = your_oracle_password
database.oracle.DBDriver = OCI8
database.oracle.charset = AL32UTF8
database.oracle.port = 1521

# ตัวอย่าง Oracle Connection String (TNS)
# database.oracle.DSN = '(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle-server)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL)))'

#--------------------------------------------------------------------
# TIMEZONE
#--------------------------------------------------------------------

app.appTimezone = 'Asia/Bangkok'
app.defaultLocale = 'th'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'wbsc_session'
app.sessionExpiration = 7200
app.sessionSavePath = WRITEPATH . 'session'
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

#--------------------------------------------------------------------
# SECURITY - CSRF
#--------------------------------------------------------------------

security.csrfProtection = 'session'
security.tokenRandomize = false
security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = false
security.samesite = 'Lax'

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

cookie.prefix = ''
cookie.expires = 0
cookie.path = '/'
cookie.domain = ''
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =
# encryption.driver = OpenSSL
# encryption.blockSize = 16
# encryption.digest = SHA512

#--------------------------------------------------------------------
# HONEYPOT
#--------------------------------------------------------------------

honeypot.hidden = 'true'
honeypot.label = 'Fill This Field'
honeypot.name = 'honeypot'
honeypot.template = '<label>{label}</label><input type="text" name="{name}" value=""/>'
honeypot.container = '<div style="display:none">{template}</div>'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

# 0 = Disables logging
# 1 = Emergency Messages - System is unusable
# 2 = Alert Messages - Action Must Be Taken Immediately
# 3 = Critical Messages - Application component unavailable
# 4 = Error Messages - Runtime errors that do not require immediate action
# 5 = Warning Messages - Exceptional occurrences that are not errors
# 6 = Notice Messages - Normal but significant events
# 7 = Info Messages - Interesting events
# 8 = Debug Messages - Detailed debug information
# 9 = All Messages

#--------------------------------------------------------------------
# MOODLE SYNC CONFIGURATION
#--------------------------------------------------------------------

# Oracle View for Student Enrollment
moodle.oracle.viewName = 'V_STUDENT_ENROLLMENT'

# CSV File Path for Moodle Flat File Plugin
moodle.csv.filePath = '/VolFreenas/wbsc2021/moodledata/enroll_files/sync-data.csv'

# Moodle CLI Task Path
moodle.taskPath = '/path/to/moodle/admin/cli/scheduled_task.php'
moodle.phpBin = 'php74'

#--------------------------------------------------------------------
# TEACHER SYNC CONFIGURATION
#--------------------------------------------------------------------

# MariaDB Source View
teacher.source.view = 'wbsc_lms_2020.vw_course_teacher_detailed'

# Oracle Target Table
teacher.target.table = 'WBSC.COURSE_TEACHER_DETAILED'

# Batch Processing Size
teacher.batch.size = 1000

# Max Retry Attempts
teacher.max.retries = 3

#--------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional)
#--------------------------------------------------------------------

# email.fromEmail = 'noreply@wbsc.ac.th'
# email.fromName = 'WBSC Sync System'
# email.SMTPHost = 'smtp.gmail.com'
# email.SMTPUser = 'your-email@gmail.com'
# email.SMTPPass = 'your-password'
# email.SMTPPort = 587
# email.SMTPCrypto = 'tls'

#--------------------------------------------------------------------
# CUSTOM CONFIGURATION
#--------------------------------------------------------------------

# Admin Email for Notifications
# admin.email = 'admin@wbsc.ac.th'

# Sync Schedule (for reference only, actual cron must be configured)
# sync.schedule.enrollment = '0 2 * * *'    # Daily at 2:00 AM
# sync.schedule.teacher = '0 3 * * *'       # Daily at 3:00 AM

# Enable/Disable Features
# feature.enrollment.sync = true
# feature.teacher.sync = true
# feature.email.notifications = false

#--------------------------------------------------------------------
# NOTES
#--------------------------------------------------------------------
# 1. คัดลอกไฟล์นี้เป็น .env
# 2. แก้ไขค่าให้เหมาะสมกับ environment ของคุณ
# 3. ห้ามเพิ่มไฟล์ .env เข้า Git repository
# 4. ตรวจสอบว่า .env อยู่ใน .gitignore แล้ว
#--------------------------------------------------------------------